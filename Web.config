<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="8192"/>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Canonical HTTPS and www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^ataqileriteknoloji\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.ataqileriteknoloji.com/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Legacy en to root" stopProcessing="true">
          <match url="^en(?:/(.*))?$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="index.html to folder" stopProcessing="true">
          <match url="^((?:tr|de)/)?index\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="html to clean URL" stopProcessing="true">
          <match url="^((?:tr|de)/)?([^/.]+)\.html$" />
          <action type="Redirect" url="/{R:1}{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="Clean URL to html file" stopProcessing="true">
          <match url="^((?:tr|de)/)?([^/.]+)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}{R:2}.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <system.web>
    <compilation debug="false" targetFramework="4.8"/>
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
</configuration>
